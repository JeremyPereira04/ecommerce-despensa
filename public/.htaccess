Options -MultiViews
RewriteEngine On

# Conserva archivos y carpetas públicas existentes (CSS, JS e imágenes).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Envía las rutas amigables y los endpoints API al front controller.
RewriteRule ^ index.php [QSA,L]
